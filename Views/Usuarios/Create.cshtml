@model DespensaApp.Models.ViewModels.UsuarioFormViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Nuevo Usuario";
    ViewData["ActiveMenu"] = "Usuarios";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h4 class="mb-0 fw-bold ms-1">Nuevo Usuario</h4>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Nombre completo" autofocus />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Contraseña <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control" id="pwdInput"
                                   placeholder="Mínimo 8 chars, 1 mayúscula, 1 número" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()">
                                <i class="fas fa-eye" id="pwdEye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                        <div class="form-text">Mínimo 8 caracteres, 1 letra mayúscula y 1 número.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Rol" class="form-label fw-semibold"></label>
                        <select asp-for="Rol" class="form-select"
                                asp-items="@Html.GetEnumSelectList<DespensaApp.Models.Entities.RolUsuario>()">
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="Activo" class="form-check-input" type="checkbox" checked />
                            <label asp-for="Activo" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="fas fa-save me-1"></i>Crear usuario
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function togglePwd() {
    const inp = document.getElementById('pwdInput');
    const eye = document.getElementById('pwdEye');
    if (inp.type === 'password') { inp.type = 'text'; eye.classList.replace('fa-eye','fa-eye-slash'); }
    else { inp.type = 'password'; eye.classList.replace('fa-eye-slash','fa-eye'); }
}
</script>
}
