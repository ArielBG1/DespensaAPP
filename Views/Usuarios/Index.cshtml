@model IEnumerable<DespensaApp.Models.ViewModels.UsuarioListItemViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Usuarios";
    ViewData["ActiveMenu"] = "Usuarios";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <div class="me-auto">
        <h4 class="mb-0 fw-bold">Usuarios</h4>
        <p class="text-muted mb-0 small">@Model.Count() usuario(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nuevo usuario
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th class="text-center">Rol</th>
                    <th class="text-center d-none d-md-table-cell">Último acceso</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(!u.Activo ? "table-secondary opacity-75" : "")">
                        <td>
                            <div class="fw-semibold">@u.Nombre</div>
                            <div class="text-muted small d-md-none">@u.Email</div>
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">@u.Email</td>
                        <td class="text-center">
                            @if (u.Rol == DespensaApp.Models.Entities.RolUsuario.Admin)
                            {
                                <span class="badge bg-warning text-dark">Admin</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">Cajero</span>
                            }
                        </td>
                        <td class="text-center d-none d-md-table-cell text-muted small">
                            @(u.UltimoAcceso.HasValue ? u.UltimoAcceso.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")
                        </td>
                        <td class="text-center">
                            <span class="badge bg-@(u.Activo ? "success" : "secondary") bg-opacity-15 text-@(u.Activo ? "success" : "secondary")">
                                @(u.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="d-flex gap-1 justify-content-center">
                                <a asp-action="Edit" asp-route-id="@u.Id"
                                   class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="ToggleActivo" asp-route-id="@u.Id" method="post"
                                      onsubmit="return confirm('@(u.Activo ? "¿Desactivar" : "¿Activar") este usuario?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm @(u.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                            title="@(u.Activo ? "Desactivar" : "Activar")">
                                        <i class="fas @(u.Activo ? "fa-user-slash" : "fa-user-check")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
