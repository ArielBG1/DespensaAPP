@model DespensaApp.Models.ViewModels.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveMenu"] = "Dashboard";
    var m = Model.MonedaSimbolo;
    var labelsJson = System.Text.Json.JsonSerializer.Serialize(Model.GraficoLabels);
    var totalesJson = System.Text.Json.JsonSerializer.Serialize(Model.GraficoTotales);
}

<div class="d-flex align-items-center mb-4">
    <div>
        <h4 class="mb-0 fw-bold">Dashboard</h4>
        <p class="text-muted mb-0 small">@DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-success bg-opacity-10">
                    <i class="fas fa-dollar-sign text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Total vendido hoy</div>
                    <div class="fs-4 fw-bold">@m @Model.TotalVendidoHoy.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-primary bg-opacity-10">
                    <i class="fas fa-receipt text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Transacciones hoy</div>
                    <div class="fs-4 fw-bold">@Model.TransaccionesHoy</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box bg-info bg-opacity-10">
                    <i class="fas fa-chart-line text-info"></i>
                </div>
                <div>
                    <div class="text-muted small">Ticket promedio</div>
                    <div class="fs-4 fw-bold">@m @Model.TicketPromedio.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box @(Model.ProductosStockBajo > 0 ? "bg-danger bg-opacity-10" : "bg-success bg-opacity-10")">
                    <i class="fas fa-exclamation-triangle @(Model.ProductosStockBajo > 0 ? "text-danger" : "text-success")"></i>
                </div>
                <div>
                    <div class="text-muted small">Productos stock bajo</div>
                    <div class="fs-4 fw-bold @(Model.ProductosStockBajo > 0 ? "text-danger" : "")">@Model.ProductosStockBajo</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box @(Model.ProductosPorVencer > 0 ? "bg-warning bg-opacity-10" : "bg-success bg-opacity-10")">
                    <i class="fas fa-hourglass-half @(Model.ProductosPorVencer > 0 ? "text-warning" : "text-success")"></i>
                </div>
                <div>
                    <div class="text-muted small">Por vencer / vencidos</div>
                    <div class="fs-4 fw-bold @(Model.ProductosPorVencer > 0 ? "text-warning" : "")">@Model.ProductosPorVencer</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CHART + ACCESOS RÁPIDOS -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-chart-bar me-2 text-primary"></i>Ventas últimos 7 días</h6>
            </div>
            <div class="card-body">
                <canvas id="chartVentas" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-bolt text-warning me-2"></i>Accesos rápidos</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2 pt-3">
                <a asp-controller="Ventas" asp-action="Nueva" class="btn btn-outline-primary d-flex align-items-center gap-2">
                    <i class="fas fa-cash-register"></i><span>Nueva Venta</span>
                </a>
                <a asp-controller="Compras" asp-action="Nueva" class="btn btn-outline-success d-flex align-items-center gap-2">
                    <i class="fas fa-truck"></i><span>Nueva Compra</span>
                </a>
                <a asp-controller="Productos" asp-action="Create" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                    <i class="fas fa-box"></i><span>Nuevo Producto</span>
                </a>
                @if (Model.ProductosStockBajo > 0)
                {
                    <a asp-controller="Productos" asp-action="Index" asp-route-soloStockBajo="true"
                       class="btn btn-outline-danger d-flex align-items-center gap-2">
                        <i class="fas fa-exclamation-triangle"></i>
                        <span>Ver @Model.ProductosStockBajo con stock bajo</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- ALERTAS + ÚLTIMAS VENTAS -->
<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-exclamation-triangle me-2 text-warning"></i>Alertas de stock</h6>
                <a asp-controller="Productos" asp-action="Index" asp-route-soloStockBajo="true"
                   class="btn btn-sm btn-outline-warning">Ver todos</a>
            </div>
            @if (Model.AlertasStock.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Mínimo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.AlertasStock)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Productos" asp-action="Detail" asp-route-id="@p.Id"
                                           class="fw-semibold text-decoration-none small">@p.Nombre</a>
                                        @if (!string.IsNullOrEmpty(p.CodigoBarra))
                                        {
                                            <div class="text-muted" style="font-size:.72rem">@p.CodigoBarra</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger bg-opacity-15 text-danger">
                                            @p.StockActual.ToString("G29") @p.TipoVenta
                                        </span>
                                    </td>
                                    <td class="text-center text-muted small">@p.StockMinimo.ToString("G29")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-success">
                    <i class="fas fa-check-circle fa-2x mb-2 d-block"></i>
                    <small>¡Todo el stock en orden!</small>
                </div>
            }
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fas fa-hourglass-half me-2 text-warning"></i>Próximos a vencer</h6>
            </div>
            @if (Model.AlertasVencimiento.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-end">Vence</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.AlertasVencimiento)
                            {
                                var dias = (p.FechaVencimiento.Date - DateTime.UtcNow.Date).Days;
                                var clase = dias < 0 ? "danger" : "warning";
                                <tr>
                                    <td>
                                        <a asp-controller="Productos" asp-action="Detail" asp-route-id="@p.Id"
                                           class="fw-semibold text-decoration-none small">@p.Nombre</a>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-@clase bg-opacity-15 text-@clase">
                                            @(dias < 0 ? $"Venció hace {-dias}d" : dias == 0 ? "Hoy" : $"En {dias}d")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-success">
                    <i class="fas fa-check-circle fa-2x mb-2 d-block"></i>
                    <small>Sin productos próximos a vencer.</small>
                </div>
            }
        </div>

        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-receipt me-2 text-primary"></i>Últimas ventas de hoy</h6>
                <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
            </div>
            @if (Model.UltimasVentas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ticket</th>
                                <th>Cajero</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.UltimasVentas)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Ventas" asp-action="Detail" asp-route-id="@v.Id"
                                           class="fw-semibold text-decoration-none" style="font-size:.85rem">@v.NumeroTicket</a>
                                        <div class="text-muted" style="font-size:.72rem">@v.FechaHora.ToLocalTime().ToString("HH:mm:ss")</div>
                                    </td>
                                    <td class="text-muted small">@v.Cajero</td>
                                    <td class="text-end fw-bold">@m @v.Total.ToString("N0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-receipt fa-2x mb-2 d-block opacity-25"></i>
                    <small>Sin ventas registradas hoy</small>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
    const labels = @Html.Raw(labelsJson);
    const data   = @Html.Raw(totalesJson);
    const moneda = '@Html.Raw(m)';
    new Chart(document.getElementById('chartVentas'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: `Ventas (${moneda})`,
                data,
                backgroundColor: 'rgba(37,99,235,.12)',
                borderColor: 'rgba(37,99,235,.7)',
                borderWidth: 2,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: { callbacks: { label: ctx => moneda + ' ' + Math.round(ctx.parsed.y).toLocaleString('es-PY') } }
            },
            scales: {
                y: { beginAtZero: true, ticks: { callback: v => moneda + ' ' + Math.round(v).toLocaleString('es-PY') } }
            }
        }
    });
})();
</script>
}
