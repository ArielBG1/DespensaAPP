@model DespensaApp.Models.ViewModels.ProductoFormViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Editar: {Model.Nombre}";
    ViewData["ActiveMenu"] = "Productos";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h4 class="mb-0 fw-bold">Editar Producto</h4>
        <p class="text-muted mb-0 small">@Model.Nombre</p>
    </div>
    <div class="ms-auto d-flex gap-2">
        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-eye me-1"></i>Ver detalle
        </a>
        <a asp-action="Movimientos" asp-route-id="@Model.Id" class="btn btn-outline-info btn-sm">
            <i class="fas fa-history me-1"></i>Movimientos
        </a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post"
      enctype="multipart/form-data" id="formProducto" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"
         style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

    <div class="row g-4">
        <!-- ═══ COLUMNA IZQUIERDA ═══ -->
        <div class="col-12 col-xl-8">

            <!-- CÓDIGO DE BARRAS -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-barcode me-2 text-primary"></i>Código de Barras
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-start">
                        <div class="col">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fas fa-barcode text-muted"></i>
                                </span>
                                <input asp-for="CodigoBarra" id="codigoBarraInput"
                                       class="form-control border-start-0"
                                       placeholder="Escanear o escribir código..."
                                       autocomplete="off" />
                            </div>
                            <span asp-validation-for="CodigoBarra" class="text-danger small"></span>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-primary" id="btnEscanear" title="Esperar lectora física">
                                <i class="fas fa-keyboard me-1"></i>Lectora
                            </button>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-primary" id="btnCamara" title="Escanear con la cámara">
                                <i class="fas fa-camera me-1"></i>Cámara
                            </button>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-outline-secondary" id="btnGenerarCodigo"
                                    title="Generar un código interno para un producto sin código de fábrica">
                                <i class="fas fa-magic me-1"></i>Generar
                            </button>
                        </div>
                    </div>
                    <div id="alertaCodigoExistente" class="alert alert-warning py-2 mt-2 d-none">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Este código ya pertenece a:
                        <strong id="nombreProductoExistente"></strong>
                        <a id="linkProductoExistente" href="#" class="ms-2 alert-link small">Ver producto</a>
                    </div>
                    <div id="previewCodigoBarra" class="mt-3 p-3 rounded-3 text-center d-none"
                         style="background:#f8fafc;border:1px dashed #cbd5e1;">
                        <div id="svgCodigoBarra" class="d-flex justify-content-center mb-2"></div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnImprimirCodigo">
                            <i class="fas fa-print me-1"></i>Imprimir etiqueta
                        </button>
                    </div>

                    <!-- Códigos de barra alternativos -->
                    <hr class="my-3" />
                    <label class="form-label fw-semibold small">
                        Códigos alternativos
                        <span class="text-muted fw-normal">(el mismo producto viene con otro código, ej. caja vs. unidad)</span>
                    </label>
                    <div id="listaCodigosAlternativos" class="d-flex flex-column gap-2 mb-2"></div>
                    <div class="input-group input-group-sm" style="max-width:320px;">
                        <input type="text" id="inputNuevoCodigoAlt" class="form-control" placeholder="Agregar código alternativo..." />
                        <button type="button" class="btn btn-outline-secondary" id="btnAgregarCodigoAlt">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- INFORMACIÓN BÁSICA -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Información Básica
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <select asp-for="CategoriaId" asp-items="Model.CategoriasItems"
                                        class="form-select">
                                    <option value="">— Sin categoría —</option>
                                </select>
                                <button type="button" class="btn btn-outline-secondary"
                                        id="btnNuevaCategoria" title="Nueva categoría">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="ProveedorId" class="form-label fw-semibold"></label>
                            <select asp-for="ProveedorId" asp-items="Model.ProveedoresItems"
                                    class="form-select">
                                <option value="">— Sin proveedor —</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="FechaVencimiento" class="form-label fw-semibold"></label>
                            <input asp-for="FechaVencimiento" type="date" class="form-control" />
                            <span asp-validation-for="FechaVencimiento" class="text-danger small"></span>
                            <small class="text-muted">Opcional. Habilita alertas de vencimiento próximo.</small>
                        </div>
                        <div class="col-12">
                            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TIPO DE VENTA -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-tag me-2 text-primary"></i>Tipo de Venta
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @{
                            var tipos = new[]
                            {
                                (TipoVenta.Unidad, "📦", "Por unidad",    "Unidad"),
                                (TipoVenta.Kg,     "⚖️", "Por kilogramo", "Kg"),
                                (TipoVenta.Gramo,  "🔢", "Por gramo",     "Gramo"),
                                (TipoVenta.Cien_g, "📏", "Por 100g",      "Cien_g"),
                            };
                        }
                        @foreach (var (tipo, emoji, label, val) in tipos)
                        {
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="TipoVenta"
                                       id="tipo_@val" value="@val"
                                       @(Model.TipoVenta == tipo ? "checked" : "") />
                                <label class="btn btn-outline-primary w-100 py-3 d-flex flex-column align-items-center gap-1"
                                       for="tipo_@val">
                                    <span style="font-size:1.4rem;line-height:1">@emoji</span>
                                    <span class="small fw-semibold">@label</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- PRECIOS -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-dollar-sign me-2 text-primary"></i>Precios
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-4">
                            <label asp-for="PrecioCompra" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">Gs.</span>
                                <input asp-for="PrecioCompra" type="number" step="1" min="0"
                                       class="form-control" id="inputPrecioCompra" />
                            </div>
                            <span asp-validation-for="PrecioCompra" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <label asp-for="PrecioVenta" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">Gs.</span>
                                <input asp-for="PrecioVenta" type="number" step="1" min="1"
                                       class="form-control" id="inputPrecioVenta" />
                            </div>
                            <span asp-validation-for="PrecioVenta" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="rounded-3 p-3 text-center"
                                 style="background:#f0fdf4;border:1px dashed #86efac;">
                                <div class="text-muted small">Margen</div>
                                <div class="fs-4 fw-bold text-success" id="margenDisplay">—</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STOCK (solo mínimo en edit) -->
            <div class="card border-0 shadow-sm" style="border-radius:12px;">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-warehouse me-2 text-primary"></i>Stock
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-semibold text-muted">Stock actual (sólo lectura)</label>
                            <div class="input-group">
                                <input type="text" class="form-control bg-light"
                                       value="@Model.StockActual.ToString("G29")" readonly />
                                <span class="input-group-text" id="unidadStockActual"></span>
                            </div>
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Para modificar el stock usa el botón
                                <strong>Ajustar Stock</strong>.
                            </small>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="StockMinimo" class="form-label fw-semibold">
                                Stock mínimo (alerta)
                                <small class="text-muted fw-normal" id="labelUnidadStockMin"></small>
                            </label>
                            <input asp-for="StockMinimo" type="number" step="0.001" min="0"
                                   class="form-control" />
                            <span asp-validation-for="StockMinimo" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ COLUMNA DERECHA ═══ -->
        <div class="col-12 col-xl-4">

            <!-- Imagen -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fas fa-image me-2 text-primary"></i>Imagen del Producto
                    </h6>
                </div>
                <div class="card-body text-center">
                    <div id="imagePreviewContainer"
                         class="rounded-3 mb-3 d-flex align-items-center justify-content-center"
                         style="width:100%;height:180px;background:#f8fafc;border:2px dashed #cbd5e1;overflow:hidden;">
                        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                        {
                            <img id="imagePreview" src="@Model.ImagenUrl" alt="@Model.Nombre"
                                 style="max-width:100%;max-height:100%;object-fit:contain;" />
                            <div id="imagePlaceholder" class="text-muted d-none">
                                <i class="fas fa-image fa-3x mb-2 d-block opacity-25"></i>
                                <small>Sin imagen</small>
                            </div>
                        }
                        else
                        {
                            <div id="imagePlaceholder" class="text-muted">
                                <i class="fas fa-image fa-3x mb-2 d-block opacity-25"></i>
                                <small>Sin imagen</small>
                            </div>
                            <img id="imagePreview" src="#" alt="Preview"
                                 class="d-none" style="max-width:100%;max-height:100%;object-fit:contain;" />
                        }
                    </div>
                    <label for="ImagenFile" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="fas fa-upload me-1"></i>
                        @(string.IsNullOrEmpty(Model.ImagenUrl) ? "Seleccionar imagen" : "Cambiar imagen")
                    </label>
                    <input asp-for="ImagenFile" type="file" id="ImagenFile"
                           class="d-none" accept="image/jpeg,image/png,image/webp" />
                    <p class="text-muted small mt-2 mb-0">JPG, PNG, WebP · Máx. 5 MB</p>
                </div>
            </div>

            <!-- Estado -->
            <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-semibold">Estado del producto</div>
                            <small class="text-muted">Desactivar lo oculta del sistema</small>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input asp-for="Activo" class="form-check-input" style="width:3em;height:1.5em;" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ajustar stock rápido -->
            @if (User.IsInRole("Admin"))
            {
                <div class="card border-0 shadow-sm mb-4" style="border-radius:12px;border-left:4px solid #f59e0b !important;">
                    <div class="card-body">
                        <div class="fw-semibold mb-1">
                            <i class="fas fa-sliders-h me-2 text-warning"></i>Ajuste de Stock
                        </div>
                        <small class="text-muted d-block mb-3">
                            El stock se gestiona exclusivamente mediante ajustes para mantener el historial.
                        </small>
                        <button type="button" class="btn btn-warning btn-sm w-100"
                                onclick="abrirModal()">
                            <i class="fas fa-sliders-h me-1"></i>Ajustar Stock ahora
                        </button>
                    </div>
                </div>
            }

            <!-- Botones -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-save me-2"></i>Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</form>

<!-- MODAL AJUSTE STOCK (inline en Edit) -->
@if (User.IsInRole("Admin"))
{
    <partial name="_ModalAjusteStock" />
}

<!-- MODAL NUEVA CATEGORÍA -->
<div class="modal fade" id="modalNuevaCat" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">Nueva Categoría</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="nuevaCatNombre" class="form-control" maxlength="100" />
                </div>
                <div class="mb-1">
                    <label class="form-label">Descripción</label>
                    <input type="text" id="nuevaCatDesc" class="form-control" maxlength="300" />
                </div>
                <div id="nuevaCatError" class="text-danger small mt-1"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnGuardarCategoria">
                    <i class="fas fa-save me-1"></i>Crear
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script src="~/js/barcode-reader.js"></script>
<script src="~/js/camera-scanner.js"></script>
<script src="~/js/ean13-render.js"></script>
<script>
const PRODUCTO_ID = @Model.Id;

BarcodeReader.init('codigoBarraInput', async function(code) {
    document.getElementById('codigoBarraInput').value = code;
    BarcodeReader.disableScan();
    await verificarCodigo(code);
    mostrarPreviewCodigo(code);
});
document.getElementById('btnEscanear').addEventListener('click', () => BarcodeReader.enableScan());

document.getElementById('btnCamara').addEventListener('click', () => {
    CameraScanner.open(async (codigo) => {
        document.getElementById('codigoBarraInput').value = codigo;
        await verificarCodigo(codigo);
        mostrarPreviewCodigo(codigo);
    });
});

document.getElementById('btnGenerarCodigo').addEventListener('click', async () => {
    const btn = document.getElementById('btnGenerarCodigo');
    btn.disabled = true;
    try {
        const resp = await fetch('/Productos/GenerarCodigoBarra');
        const data = await resp.json();
        if (!data.ok) { alert(data.error || 'No se pudo generar el código.'); return; }
        document.getElementById('codigoBarraInput').value = data.codigo;
        document.getElementById('alertaCodigoExistente').classList.add('d-none');
        mostrarPreviewCodigo(data.codigo);
    } catch {
        alert('Error al generar el código.');
    } finally {
        btn.disabled = false;
    }
});

function mostrarPreviewCodigo(codigo) {
    const preview = document.getElementById('previewCodigoBarra');
    if (!codigo || !/^\d{13}$/.test(codigo)) { preview.classList.add('d-none'); return; }
    Ean13Render.renderSvg('svgCodigoBarra', codigo);
    preview.classList.remove('d-none');
}

document.getElementById('btnImprimirCodigo').addEventListener('click', () => {
    const svg = document.getElementById('svgCodigoBarra').innerHTML;
    const nombre = document.querySelector('[name="Nombre"]')?.value || '';
    const w = window.open('', '_blank', 'width=400,height=300');
    w.document.write(`<html><head><title>Etiqueta<\/title><\/head><body style="text-align:center;font-family:sans-serif;padding:20px;">
        <div style="font-size:14px;margin-bottom:8px;">${nombre}<\/div>${svg}<\/body><\/html>`);
    w.document.close();
    w.focus();
    w.print();
});

// ── Códigos de barra alternativos ───────────────────────────────
let codigosAlternativos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CodigosAlternativos));

function renderCodigosAlternativos() {
    const cont = document.getElementById('listaCodigosAlternativos');
    cont.innerHTML = codigosAlternativos.map((c, i) => `
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border" style="font-family:monospace;">${c}</span>
            <input type="hidden" name="CodigosAlternativos" value="${c}" />
            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="quitarCodigoAlternativo(${i})">
                <i class="fas fa-times"></i>
            </button>
        </div>`).join('') || '<span class="text-muted small">Sin códigos alternativos.</span>';
}

function quitarCodigoAlternativo(idx) {
    codigosAlternativos.splice(idx, 1);
    renderCodigosAlternativos();
}
window.quitarCodigoAlternativo = quitarCodigoAlternativo;

document.getElementById('btnAgregarCodigoAlt').addEventListener('click', () => {
    const input = document.getElementById('inputNuevoCodigoAlt');
    const valor = input.value.trim();
    if (!valor) return;
    if (codigosAlternativos.includes(valor)) { input.value = ''; return; }
    codigosAlternativos.push(valor);
    input.value = '';
    renderCodigosAlternativos();
});
document.getElementById('inputNuevoCodigoAlt').addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('btnAgregarCodigoAlt').click(); }
});
renderCodigosAlternativos();

async function verificarCodigo(codigo) {
    if (!codigo || codigo.length < 2) return;
    try {
        const resp = await fetch(`/Productos/CheckCodigoBarra?codigo=${encodeURIComponent(codigo)}&idActual=${PRODUCTO_ID}`);
        const data = await resp.json();
        const alerta = document.getElementById('alertaCodigoExistente');
        if (data.existe) {
            document.getElementById('nombreProductoExistente').textContent = data.nombre;
            document.getElementById('linkProductoExistente').href = `/Productos/Detail/${data.id}`;
            alerta.classList.remove('d-none');
        } else {
            alerta.classList.add('d-none');
        }
    } catch {}
}
document.getElementById('codigoBarraInput').addEventListener('blur', function() {
    if (this.value.trim().length >= 2) {
        verificarCodigo(this.value.trim());
        mostrarPreviewCodigo(this.value.trim());
    }
});

// Si el producto ya tiene código, mostrar la vista previa al cargar la página.
if (document.getElementById('codigoBarraInput').value.trim().length === 13) {
    mostrarPreviewCodigo(document.getElementById('codigoBarraInput').value.trim());
}

// Margen
const ic = document.getElementById('inputPrecioCompra');
const iv = document.getElementById('inputPrecioVenta');
const me = document.getElementById('margenDisplay');
function calcularMargen() {
    const c = parseFloat(ic.value)||0, v = parseFloat(iv.value)||0;
    if (c <= 0) { me.textContent='—'; return; }
    const m = ((v-c)/c*100).toFixed(1);
    me.textContent = m+'%';
    me.className = 'fs-4 fw-bold '+(m>=0?'text-success':'text-danger');
}
ic.addEventListener('input', calcularMargen);
iv.addEventListener('input', calcularMargen);
calcularMargen();

// Unidades
const unidadMap = { Unidad:'unidades', Kg:'kg', Gramo:'gramos', Cien_g:'×100g' };
function actualizarUnidades() {
    const sel = document.querySelector('input[name="TipoVenta"]:checked');
    const u = sel ? (unidadMap[sel.value]||'') : '';
    document.getElementById('unidadStockActual').textContent = u;
    document.getElementById('labelUnidadStockMin').textContent = u ? '('+u+')' : '';
}
document.querySelectorAll('input[name="TipoVenta"]').forEach(r => r.addEventListener('change', actualizarUnidades));
actualizarUnidades();

// Preview imagen
document.getElementById('ImagenFile').addEventListener('change', function() {
    const file = this.files[0]; if (!file) return;
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('imagePlaceholder').classList.add('d-none');
        const img = document.getElementById('imagePreview');
        img.src = e.target.result;
        img.classList.remove('d-none');
    };
    reader.readAsDataURL(file);
});

// Ajuste de stock modal (desde Edit)
function abrirModal() {
    document.getElementById('ajusteProductoId').value = PRODUCTO_ID;
    document.getElementById('ajusteNombreProducto').textContent = '@Html.Raw(Model.Nombre.Replace("'","&#39;"))';
    const stock = '@Model.StockActual.ToString("G29")';
    const unidad = '@(Model.TipoVenta == TipoVenta.Unidad ? "u" : Model.TipoVenta == TipoVenta.Kg ? "kg" : Model.TipoVenta == TipoVenta.Gramo ? "g" : "×100g")';
    document.getElementById('ajusteStockActual').textContent = stock + ' ' + unidad;
    document.getElementById('ajusteUnidadLabel').textContent = unidad ? '('+unidad+')' : '';
    document.getElementById('ajusteCantidad').value='';
    document.getElementById('ajusteMotivo').value='';
    document.querySelectorAll('input[name="Tipo"]').forEach(r => r.checked=false);
    new bootstrap.Modal(document.getElementById('modalAjusteStock')).show();
    setTimeout(()=>document.getElementById('ajusteCantidad').focus(),400);
}

// Nueva categoría
document.getElementById('btnNuevaCategoria').addEventListener('click', () => {
    document.getElementById('nuevaCatNombre').value='';
    document.getElementById('nuevaCatDesc').value='';
    document.getElementById('nuevaCatError').textContent='';
    new bootstrap.Modal(document.getElementById('modalNuevaCat')).show();
    setTimeout(()=>document.getElementById('nuevaCatNombre').focus(),400);
});
document.getElementById('btnGuardarCategoria').addEventListener('click', async () => {
    const nombre = document.getElementById('nuevaCatNombre').value.trim();
    const desc   = document.getElementById('nuevaCatDesc').value.trim();
    const errEl  = document.getElementById('nuevaCatError');
    if (!nombre) { errEl.textContent='El nombre es obligatorio.'; return; }
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    try {
        const resp = await fetch('/Productos/CrearCategoriaRapida',{
            method:'POST', headers:{'Content-Type':'application/json','X-XSRF-TOKEN':token},
            body:JSON.stringify({nombre,descripcion:desc})
        });
        const data = await resp.json();
        if (!data.ok) { errEl.textContent=data.error; return; }
        const select = document.getElementById('CategoriaId');
        select.add(new Option(data.nombre, data.id, true, true));
        bootstrap.Modal.getInstance(document.getElementById('modalNuevaCat')).hide();
    } catch { errEl.textContent='Error al crear la categoría.'; }
});
</script>
}
