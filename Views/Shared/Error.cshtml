@model DespensaApp.Models.ErrorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.StatusMessage;
    var is404 = Model.StatusCode == 404;
    var icon = is404 ? "fa-map-signs" : "fa-exclamation-circle";
    var color = is404 ? "warning" : "danger";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <div class="mb-4" style="font-size:5rem;opacity:.2;">
        <i class="fas @icon text-@color"></i>
    </div>
    <h1 class="display-4 fw-black text-@color mb-1">@Model.StatusCode</h1>
    <h4 class="mb-3 text-muted">@Model.StatusMessage</h4>

    @if (is404)
    {
        <p class="text-muted mb-4">La página que buscas no existe o fue movida.</p>
    }
    else
    {
        <p class="text-muted mb-4">Ocurrió un error inesperado. Por favor intente nuevamente.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">ID: <code>@Model.RequestId</code></p>
        }
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
        <i class="fas fa-home me-2"></i>Volver al inicio
    </a>
</div>
