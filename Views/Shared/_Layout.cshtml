<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(ViewData["NombreNegocio"] ?? "Despensa App")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 70px;
            --topbar-height: 56px;
            --primary: #2563eb;
            --primary-dark: #1e40af;
            --sidebar-bg: #1e293b;
            --sidebar-text: #cbd5e1;
            --sidebar-active: #2563eb;
        }

        body { background: #f1f5f9; overflow-x: hidden; }

        /* TOPBAR */
        .topbar {
            position: fixed; top: 0; left: 0; right: 0;
            height: var(--topbar-height);
            background: var(--primary);
            display: flex; align-items: center;
            padding: 0 1rem; gap: 1rem;
            z-index: 1030; box-shadow: 0 2px 8px rgba(0,0,0,.2);
        }
        .topbar .brand { color: #fff; font-weight: 700; font-size: 1.1rem; text-decoration: none; display: flex; align-items: center; gap: .5rem; }
        .topbar .brand i { font-size: 1.3rem; }
        .topbar .spacer { flex: 1; }
        .topbar .user-info { display: flex; align-items: center; gap: .6rem; color: #fff; }
        .topbar .user-info .badge { font-size: .7rem; }
        .topbar .btn-logout { background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.3); color: #fff; border-radius: 6px; padding: .35rem .75rem; font-size: .85rem; transition: background .2s; }
        .topbar .btn-logout:hover { background: rgba(255,255,255,.25); }
        #sidebarToggle { background: none; border: none; color: #fff; font-size: 1.2rem; cursor: pointer; padding: 0 .5rem; }

        /* SIDEBAR */
        .sidebar {
            position: fixed; top: var(--topbar-height); left: 0; bottom: 0;
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            overflow-y: auto; overflow-x: hidden;
            transition: width .25s ease;
            z-index: 1020;
        }
        .sidebar.collapsed { width: var(--sidebar-collapsed-width); }
        .sidebar .nav-section-title {
            color: #64748b; font-size: .7rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: .08em; padding: 1rem 1.2rem .3rem;
            white-space: nowrap; overflow: hidden;
            transition: opacity .2s;
        }
        .sidebar.collapsed .nav-section-title { opacity: 0; }
        .sidebar .nav-link {
            display: flex; align-items: center; gap: .75rem;
            color: var(--sidebar-text); padding: .6rem 1.2rem;
            border-radius: 0; font-size: .9rem;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .sidebar .nav-link i { width: 20px; text-align: center; font-size: 1rem; flex-shrink: 0; }
        .sidebar .nav-link:hover { background: rgba(255,255,255,.06); color: #fff; }
        .sidebar .nav-link.active { background: var(--sidebar-active); color: #fff; }
        .sidebar.collapsed .nav-link span { display: none; }
        .sidebar.collapsed .nav-link { justify-content: center; padding: .7rem; }

        /* CONTENT */
        .main-content {
            margin-top: var(--topbar-height);
            margin-left: var(--sidebar-width);
            padding: 1.5rem;
            transition: margin-left .25s ease;
            min-height: calc(100vh - var(--topbar-height));
        }
        .main-content.expanded { margin-left: var(--sidebar-collapsed-width); }

        @@media (max-width: 768px) {
            .sidebar { width: 0; }
            .sidebar.mobile-open { width: var(--sidebar-width); }
            .main-content { margin-left: 0 !important; }
        }

        /* CARDS */
        .stat-card { border: none; border-radius: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .stat-card .icon-box { width: 52px; height: 52px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
    <button id="sidebarToggle" title="Menú"><i class="fas fa-bars"></i></button>
    <a class="brand" asp-controller="Home" asp-action="Index">
        <i class="fas fa-store"></i>
        <span>@(ViewData["NombreNegocio"] ?? "Despensa App")</span>
    </a>
    <div class="spacer"></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="user-info d-none d-sm-flex">
            <i class="fas fa-user-circle fa-lg"></i>
            <div class="d-flex flex-column lh-1">
                <span style="font-size:.88rem;font-weight:600">@User.Identity.Name</span>
                @if (User.IsInRole("Admin"))
                {
                    <span class="badge bg-warning text-dark mt-1">Admin</span>
                }
                else
                {
                    <span class="badge bg-info mt-1">Cajero</span>
                }
            </div>
        </div>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="mb-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-logout">
                <i class="fas fa-sign-out-alt me-1"></i><span class="d-none d-md-inline">Salir</span>
            </button>
        </form>
    }
</div>

<!-- SIDEBAR -->
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="sidebar" id="sidebar">
        @if (User.IsInRole("Admin"))
        {
            <div class="nav-section-title">Principal</div>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Dashboard" ? "active" : "")"
               asp-controller="Home" asp-action="Index">
                <i class="fas fa-tachometer-alt"></i><span>Dashboard</span>
            </a>

            <div class="nav-section-title">Comercial</div>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Ventas" ? "active" : "")"
               asp-controller="Ventas" asp-action="Index">
                <i class="fas fa-cash-register"></i><span>Ventas</span>
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Compras" ? "active" : "")"
               asp-controller="Compras" asp-action="Index">
                <i class="fas fa-truck"></i><span>Compras</span>
            </a>

            <div class="nav-section-title">Inventario</div>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Productos" ? "active" : "")"
               asp-controller="Productos" asp-action="Index">
                <i class="fas fa-box"></i><span>Productos</span>
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Categorias" ? "active" : "")"
               asp-controller="Categorias" asp-action="Index">
                <i class="fas fa-tags"></i><span>Categorías</span>
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Proveedores" ? "active" : "")"
               asp-controller="Proveedores" asp-action="Index">
                <i class="fas fa-industry"></i><span>Proveedores</span>
            </a>

            <div class="nav-section-title">Administración</div>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Usuarios" ? "active" : "")"
               asp-controller="Usuarios" asp-action="Index">
                <i class="fas fa-users"></i><span>Usuarios</span>
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "Configuracion" ? "active" : "")"
               asp-controller="Configuracion" asp-action="Index">
                <i class="fas fa-cog"></i><span>Configuración</span>
            </a>
        }
        else
        {
            <div class="nav-section-title">Ventas</div>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "NuevaVenta" ? "active" : "")"
               asp-controller="Ventas" asp-action="Nueva">
                <i class="fas fa-plus-circle"></i><span>Nueva Venta</span>
            </a>
            <a class="nav-link @(ViewData["ActiveMenu"]?.ToString() == "MisVentas" ? "active" : "")"
               asp-controller="Ventas" asp-action="MisVentasHoy">
                <i class="fas fa-list-alt"></i><span>Mis Ventas del día</span>
            </a>
        }
    </nav>
}

<!-- MAIN CONTENT -->
<div class="main-content @(User.Identity?.IsAuthenticated == true ? "" : "ms-0")" id="mainContent">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 py-2" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 py-2" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');
    const toggle = document.getElementById('sidebarToggle');

    if (toggle && sidebar) {
        toggle.addEventListener('click', () => {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle('mobile-open');
            } else {
                sidebar.classList.toggle('collapsed');
                mainContent?.classList.toggle('expanded');
            }
        });
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
