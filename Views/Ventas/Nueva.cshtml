@{
    Layout = "_Layout";
    ViewData["Title"] = "Nueva Venta";
    ViewData["ActiveMenu"] = "NuevaVenta";
    var moneda = ViewData["MonedaSimbolo"]?.ToString() ?? "Gs.";
}

<meta name="xsrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

<style>
.pos-wrap {
    display: flex;
    height: calc(100vh - 56px);
    overflow: hidden;
    margin: -1.5rem;
}

/* Columna carrito */
.pos-left {
    flex: 0 0 60%;
    display: flex;
    flex-direction: column;
    border-right: 2px solid #e2e8f0;
    overflow: hidden;
}
.pos-left-header {
    padding: .75rem 1rem;
    background: #1e293b;
    color: #fff;
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-shrink: 0;
}
.pos-left-body {
    flex: 1;
    overflow-y: auto;
}
.pos-left-footer {
    border-top: 2px solid #e2e8f0;
    background: #f8fafc;
    padding: .75rem 1rem;
    flex-shrink: 0;
}

/* Columna búsqueda */
.pos-right {
    flex: 0 0 40%;
    display: flex;
    flex-direction: column;
    background: #f8fafc;
    overflow: hidden;
}
.pos-right-header {
    padding: .75rem 1rem;
    background: #0f172a;
    color: #94a3b8;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .06em;
    font-weight: 700;
    flex-shrink: 0;
}
.pos-right-body {
    flex: 1;
    overflow-y: auto;
    padding: .75rem;
}

/* Tabla carrito */
#carritoTable th, #carritoTable td { padding: .45rem .5rem; }
#carritoTable th { font-size: .75rem; color: #64748b; text-transform: uppercase; letter-spacing: .04em; }
.cant-cell:hover { background: #eff6ff; border-radius: 4px; }

/* Totales */
.total-line { display: flex; justify-content: space-between; align-items: baseline; padding: .2rem 0; }
.total-grande { font-size: 1.7rem; font-weight: 900; color: #1e293b; }

/* Búsqueda dropdown */
#busquedaDropdown {
    display: none;
    position: absolute;
    width: 100%;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 0 0 8px 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,.12);
    z-index: 200;
    max-height: 280px;
    overflow-y: auto;
}
.search-item.active { background: #eff6ff; }

/* Botón cobrar */
.btn-cobrar {
    background: linear-gradient(135deg, #16a34a, #15803d);
    color: #fff;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: .04em;
    border: none;
    border-radius: 10px;
    padding: .65rem;
    width: 100%;
    transition: opacity .2s;
}
.btn-cobrar:hover:not(:disabled) { opacity: .92; }
.btn-cobrar:disabled { background: #94a3b8; }

/* Métodos de pago */
.metodo-btn {
    border: 2px solid #e2e8f0;
    border-radius: 10px;
    padding: .6rem .4rem;
    background: #fff;
    cursor: pointer;
    transition: all .15s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .25rem;
    font-size: .78rem;
    font-weight: 600;
}
.metodo-btn:hover { border-color: #3b82f6; background: #eff6ff; }
.metodo-btn.active { border-color: #1d4ed8; background: #1d4ed8; color: #fff; }
.metodo-btn i { font-size: 1.3rem; }

@@media (max-width: 768px) {
    .pos-wrap { flex-direction: column; height: auto; }
    .pos-left, .pos-right { flex: none; }
    .pos-left-body { max-height: 40vh; }
}
</style>

<div class="pos-wrap" id="posWrap">

    <!-- ══════════════════════ COLUMNA CARRITO ══════════════════════ -->
    <div class="pos-left">
        <div class="pos-left-header">
            <i class="fas fa-shopping-cart me-1"></i>
            <span class="fw-bold">Carrito</span>
            <span class="badge bg-secondary ms-1" id="nItemsDisplay" style="font-size:.75rem">0 item(s)</span>
            <div class="ms-auto d-flex gap-2">
                @if (User.IsInRole("Admin"))
                {
                    <button class="btn btn-sm btn-outline-light" id="btnDescuentoGlobal"
                            onclick="abrirModalDescuento()" disabled title="Descuento global">
                        <i class="fas fa-tag me-1"></i>Dto.
                    </button>
                }
                <button class="btn btn-sm btn-outline-danger"
                        onclick="limpiarCarrito()" title="Cancelar venta">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
            </div>
        </div>

        <!-- Tabla de items -->
        <div class="pos-left-body">
            <div id="alertaCodigo" class="alert py-2 mx-2 mt-2" style="display:none;font-size:.87rem;"></div>
            <table class="table table-sm" id="carritoTable">
                <thead class="sticky-top bg-white">
                    <tr>
                        <th>Cant.</th>
                        <th>Producto</th>
                        <th class="text-end">Precio</th>
                        <th class="text-end">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="carritoBody"></tbody>
            </table>
        </div>

        <!-- Footer con totales + cobrar -->
        <div class="pos-left-footer">
            <div class="total-line text-muted" style="font-size:.88rem">
                <span>Subtotal</span>
                <span id="subtotalDisplay">@moneda 0</span>
            </div>
            <div class="total-line text-danger" style="font-size:.88rem">
                <span>Descuento</span>
                <span id="descuentoDisplay">-@moneda 0</span>
            </div>
            <div class="total-line mt-1">
                <span class="fw-bold fs-5">TOTAL</span>
                <span class="total-grande" id="totalDisplay">@moneda 0</span>
            </div>
            <button class="btn-cobrar mt-3" id="btnCobrar"
                    onclick="abrirModalPago()" disabled>
                <i class="fas fa-cash-register me-2"></i>COBRAR
            </button>
        </div>
    </div>

    <!-- ══════════════════════ COLUMNA BÚSQUEDA ══════════════════════ -->
    <div class="pos-right">
        <div class="pos-right-header">
            <i class="fas fa-search me-2"></i>Agregar Producto
        </div>
        <div class="pos-right-body">

            <!-- Escáner código de barras -->
            <div class="card border-0 shadow-sm mb-3" style="border-radius:10px;">
                <div class="card-body p-3">
                    <label class="form-label fw-bold mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:#475569;">
                        <i class="fas fa-barcode me-1 text-primary"></i>Código de Barras
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-primary text-white border-0">
                            <i class="fas fa-barcode"></i>
                        </span>
                        <input type="text" id="codigoBarraInput"
                               class="form-control border-start-0 fw-semibold"
                               placeholder="Escanear código..."
                               autocomplete="off" autocorrect="off" spellcheck="false"
                               style="font-size:1rem;letter-spacing:.05em;" />
                        <button class="btn btn-outline-primary" type="button"
                                onclick="BarcodeReader.enableScan()" title="Esperar lectora física">
                            <i class="fas fa-keyboard"></i>
                        </button>
                        <button class="btn btn-outline-primary" type="button"
                                id="btnCamaraVenta" title="Escanear con la cámara">
                            <i class="fas fa-camera"></i>
                        </button>
                    </div>
                    <small class="text-muted">Foco automático · Enter para buscar · sin lectora, usá la cámara</small>
                </div>
            </div>

            <!-- Búsqueda por nombre -->
            <div class="card border-0 shadow-sm mb-3" style="border-radius:10px;">
                <div class="card-body p-3">
                    <label class="form-label fw-bold mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:#475569;">
                        <i class="fas fa-search me-1 text-primary"></i>Buscar por nombre
                    </label>
                    <div class="position-relative">
                        <input type="text" id="busquedaInput"
                               class="form-control"
                               placeholder="Escribir nombre del producto..."
                               autocomplete="off" />
                        <div id="busquedaDropdown"></div>
                    </div>
                    <small class="text-muted">Mínimo 2 caracteres · Flechas ↑↓ para navegar</small>
                </div>
            </div>

            <!-- Atajos rápidos (recientes) -->
            <div id="recientesSection" class="card border-0 shadow-sm" style="border-radius:10px;display:none;">
                <div class="card-body p-3">
                    <div class="fw-bold mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.05em;color:#475569;">
                        <i class="fas fa-clock me-1 text-muted"></i>Último producto agregado
                    </div>
                    <div id="recientesLista"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════ MODAL: PRODUCTO POR PESO ══════════════════════ -->
<div class="modal fade" id="modalPeso" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:380px;">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0" style="background:linear-gradient(135deg,#0f172a,#1e40af);color:#fff;border-radius:12px 12px 0 0;">
                <div>
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-weight-hanging me-2"></i>Producto por peso
                    </h6>
                    <div class="small opacity-75 mt-1" id="pesoProdNombre">—</div>
                </div>
            </div>
            <div class="modal-body pt-3">
                <div class="text-center mb-3 p-3 rounded-3" style="background:#f0f9ff;">
                    <div class="text-muted small">Precio unitario</div>
                    <div class="fs-3 fw-bold text-primary">
                        <span id="pesoPrecioCalc">@moneda 0</span>
                        <small class="fs-6 text-muted fw-normal" id="pesoProdUnidad">/ kg</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Cantidad <span id="pesoUnidadLabel" class="text-muted fw-normal"></span></label>
                    <input type="number" id="pesoInputCantidad"
                           class="form-control form-control-lg text-center fw-bold"
                           min="0.001" step="0.001" placeholder="0.000"
                           style="font-size:1.8rem;letter-spacing:.05em;" />
                    <div class="invalid-feedback">Ingrese una cantidad mayor a 0.</div>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-3"
                     style="background:#f0fdf4;border:1px solid #86efac;">
                    <span class="fw-semibold text-success">Total calculado</span>
                    <span class="fs-4 fw-bold text-success" id="pesoTotalCalc">@moneda 0</span>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 gap-2">
                <button type="button" class="btn btn-light flex-grow-1"
                        data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary flex-grow-1 fw-bold"
                        onclick="confirmarPeso()">
                    <i class="fas fa-plus me-1"></i>Agregar al carrito
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════ MODAL: DESCUENTO GLOBAL ══════════════════════ -->
<div class="modal fade" id="modalDescuento" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">
                    <i class="fas fa-tag me-2 text-primary"></i>Descuento Global
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-muted small mb-2">
                    Subtotal: <strong id="descSubtotalRef">@moneda 0</strong>
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold">Monto de descuento (@moneda)</label>
                    <div class="input-group">
                        <span class="input-group-text">@moneda</span>
                        <input type="number" id="descInputMonto" class="form-control form-control-lg text-center fw-bold"
                               min="0" step="1" placeholder="0" />
                    </div>
                    <div class="invalid-feedback">Monto inválido.</div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="confirmarDescuento()">
                    <i class="fas fa-check me-1"></i>Aplicar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════ MODAL: PAGO ══════════════════════ -->
<div class="modal fade" id="modalPago" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0"
                 style="background:linear-gradient(135deg,#065f46,#16a34a);color:#fff;border-radius:12px 12px 0 0;">
                <div>
                    <h5 class="modal-title fw-bold mb-0">
                        <i class="fas fa-cash-register me-2"></i>Cobrar Venta
                    </h5>
                </div>
            </div>

            <div class="modal-body">
                <!-- Total -->
                <div class="text-center mb-4 p-3 rounded-3" style="background:#f0fdf4;border:2px solid #86efac;">
                    <div class="text-success small fw-semibold text-uppercase letter-spacing-1">Total a cobrar</div>
                    <div class="display-5 fw-black text-success" id="pagoTotalDisplay">@moneda 0</div>
                </div>

                <!-- Métodos de pago -->
                <div class="mb-3">
                    <div class="fw-semibold mb-2 small text-muted text-uppercase">Método de pago</div>
                    <div class="d-grid" style="grid-template-columns:repeat(4,1fr);display:grid;gap:.5rem;">
                        <button class="metodo-btn active" data-metodo="Efectivo">
                            <i class="fas fa-money-bill-wave"></i>Efectivo
                        </button>
                        <button class="metodo-btn" data-metodo="Tarjeta">
                            <i class="fas fa-credit-card"></i>Tarjeta
                        </button>
                        <button class="metodo-btn" data-metodo="Transferencia">
                            <i class="fas fa-exchange-alt"></i>Transfer.
                        </button>
                        <button class="metodo-btn" data-metodo="QR">
                            <i class="fas fa-qrcode"></i>QR
                        </button>
                    </div>
                </div>

                <!-- Monto recibido (solo efectivo) -->
                <div id="pagoMontoRow" class="mb-3">
                    <label class="form-label fw-semibold">Monto recibido</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text fw-bold">@moneda</span>
                        <input type="number" id="pagoMontoRecibido"
                               class="form-control fw-bold text-center"
                               min="0" step="1" placeholder="0"
                               style="font-size:1.4rem;" />
                    </div>
                    <div class="invalid-feedback">El monto debe ser mayor o igual al total.</div>
                </div>

                <!-- Vuelto -->
                <div id="pagoVueltoRow" class="p-3 rounded-3 text-center"
                     style="background:#fef3c7;border:1px solid #fcd34d;display:none;">
                    <div class="text-amber-700 small fw-semibold">Vuelto / Cambio</div>
                    <div class="fs-2 fw-bold" style="color:#92400e;" id="pagoVuelto">@moneda 0</div>
                </div>
            </div>

            <div class="modal-footer border-0 gap-2">
                <button type="button" class="btn btn-light"
                        data-bs-dismiss="modal" style="min-width:100px;">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-success fw-bold flex-grow-1"
                        id="btnConfirmarVenta" onclick="confirmarVenta()"
                        style="font-size:1rem;">
                    <i class="fas fa-check-circle me-2"></i>Confirmar Venta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast container -->
<div id="toastContainer"
     class="position-fixed bottom-0 end-0 p-3 d-flex flex-column gap-2"
     style="z-index:9999;"></div>

@section Scripts {
<script>
    window.MONEDA = '@Html.Raw(moneda)';
</script>
<script src="~/js/barcode-reader.js"></script>
<script src="~/js/camera-scanner.js"></script>
<script src="~/js/caja.js"></script>
<script>
document.getElementById('btnCamaraVenta').addEventListener('click', () => {
    CameraScanner.open((codigo) => {
        document.getElementById('codigoBarraInput').value = codigo;
        buscarPorCodigo(codigo);
    });
});
</script>
}
